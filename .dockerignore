# .dockerignore

# Python
__pycache__/
*.py[co]
*.so
.Python
*.egg-info/
.eggs/

# Virtual envs
venv/
env/
.venv/
*.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# Docker (рекурсивно)
docker-compose.override.yml

# Streamlit cache (не нужен в образе)
.streamlit/cache/
!.streamlit/config.toml

# Chainlit (если перешли на Streamlit)
.chainlit/

# Тесты и демо-данные (если не нужны в продакшене)
tests/
*.csv
!sample_candidates.csv